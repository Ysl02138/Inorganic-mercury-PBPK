#-------------------
# iHgRat Post-MCMC calibration
#-------------------
Integrate (Lsodes, 1e-6, 1e-6, 1);

SetPoints ("iHg_calibration_MAP_Rat.out",
           "iHg_calibration_MAP_Rat.dat", 
           0,	
           
           Ve_Aurine , 
           Ve_Afeces , 
           Ve_CBldU ,  
           Ve_CKU ,    
           Ve_CLU ,    
           Ve_CBrnU,   
           
           M_lnPLC, 
           M_lnPKC, 
           M_lnPBrnC, 
           M_lnPRestC,
           M_lnKabsC,
           M_lnKunabsC,
           M_lnKbileC,
           M_lnKurineC,
           M_lnKbrnC,
           V_lnPLC, 
           V_lnPKC, 
           V_lnPBrnC, 
           V_lnPRestC,
           V_lnKabsC,
           V_lnKunabsC,
           V_lnKbileC,
           V_lnKurineC,
           V_lnKbrnC);

Distrib (lnPLC, TruncNormal_v, M_lnPLC, V_lnPLC,             0.068, 4.673);       
Distrib (lnPKC, TruncNormal_v, M_lnPKC, V_lnPKC,             3.472, 8.077);          
Distrib (lnPBrnC, TruncNormal_v, M_lnPBrnC, V_lnPBrnC,      -2.5, 2.105);    
Distrib (lnPRestC, TruncNormal_v, M_lnPRestC, V_lnPRestC,   -2.216, 2.389);   

Distrib (lnKabsC, TruncNormal_v, M_lnKabsC, V_lnKabsC,       -6.407, -0.416);
Distrib (lnKunabsC, TruncNormal_v, M_lnKunabsC, V_lnKunabsC, -3.817, 2.175);
Distrib (lnKbileC, TruncNormal_v, M_lnKbileC, V_lnKbileC,    -2.966, 3.025);
Distrib (lnKurineC, TruncNormal_v, M_lnKurineC, V_lnKurineC, -5.521, 0.47);
Distrib (lnKbrnC, TruncNormal_v, M_lnKbrnC, V_lnKbrnC,       -6.836, 0.073);


Experiment { #Study 1, w/ single IV dose of 250 ug Hg/kg (50 ug 203Hg from Hg(NO3)2:
        
        BW0 = 0.2;
        BWgrowth=0;
        sex=1;
        Growthrate = 0.0;
        TChng 	= 0.003;
        
        # oral and IV administration
        PDose = PerDose(0.0, 24,   0,   0.05);
        IVDose = PerDose(250, 24,   0,   0.003);
        
        expowk =   PerDose(1.0, 168,   0, 0.003);
        expodur =   PerDose(1.0, 360, 0, 0.003);
        Drink = 0.0 ;
        
        Print (Aurine, 0.5, 1, 2, 4, 8, 12, 24,	48,	144,	360);
        Data  (Aurine, -1, -1, -1, -1, -1, -1, 1.306962025,	2.458860759,	3.743670886,	6.091772152);
        
        Print (Afeces , 0.5, 1, 2, 4, 8, 12, 24, 48,	144,	360);
        Data  (Afeces, -1, -1, -1, -1, -1, -1, 3.344936709, 6.82278481, 10.65506329, 13.18037975);
        

} # end of Experiment #1

Experiment { # Study 2, Multiple oral (p.o. twice weekly) of 2770   ug Hg/kg (3.75 mg/kg) for 12 weeks
        
        BW0 = 0.15;
        BWgrowth= 0;
        sex=1;
        Growthrate = 0.0;
        TChng 	= 0.05;
        
        # oral and IV administration
        PDose = NDoses(48 , 2770  , 0,	2770  , 0, 	2770  , 0,	2770  , 0, 	2770  , 0,	2770  , 0, 	
                       2770  , 0,	2770  , 0,	2770  , 0,	2770  , 0, 	2770  , 0,	2770  , 0, 	2770  , 0,	
                       2770  , 0, 	2770  , 0,	2770  , 0, 	2770  , 0,	2770  , 0, 	2770  , 0,	2770  , 0, 	
                       2770  , 0,	2770  , 0, 	2770  , 0,	2770  , 0,	
                       0 , 0.05 , 	72 , 72.05 , 	168 , 168.05 , 	240 , 240.05 , 	336 , 336.05 , 	
                       408 , 408.05 , 	504 , 504.05 , 	576 , 576.05 , 	672 , 672.05 , 	744 , 744.05 , 	
                       840 , 840.05 , 	912 , 912.05 , 	1008 , 1008.05 , 	1080 , 1080.05 , 	1176 , 1176.05 , 	
                       1248 , 1248.05 , 	1344 , 1344.05 , 	1416 , 1416.05 , 	1512 , 1512.05 , 	
                       1584 , 1584.05 , 	1680 , 1680.05 , 	1752 , 1752.05 , 	1848 , 1848.05 , 	1925 , 1925.05);
        
        expowk = 1;
        expodur = 1;
        
        IVDose = PerDose(0.0, 24,   0, 0.003);
        Drink = 0;
        
        Print (CBldU, 0.5, 1, 2, 4, 8, 12, 24, 48, 672 , 1344 , 2016);
        Data (CBldU, -1, -1, -1, -1, -1, -1, -1, -1, 0.042074074 , 0.047703704 , 0.057777778);
        
} # end of Experiment #1, Study #2. 
      
Experiment { # Study 3, Daily drinking water of 5 uM Hg, 100.0 ug/kg/day)
        
        BW0 = 0.13;
        BWgrowth=1;
        sex=1;
        Growthrate = 0.000119895;
        TChng 	= 0.05;
        
        # oral and IV administration
        PDose = PerDose(0.0, 24,   0, 0.05);
        IVDose = PerDose(0, 24,   0, 0.003);
        Drink = 100.0;
        
        expowk = 1;
        expodur = 1;
        
        Print	(Aurine,	 0.5, 1, 2, 4, 8, 12, 24, 48, 336	,	672	,	1008	,	1344);
        Data	  (Aurine,	-1, -1, -1, -1, -1, -1, -1, -1, 0.603448276	,	3.448275862	,	6.637931034	,	9.827586207);
        
        Print	(Afeces, 0.5, 1, 2, 4, 8, 12, 24, 48, 	336	,	672	,	1008	,	1344);
        Data 	(Afeces,	-1, -1, -1, -1, -1, -1, -1, -1, 206.8965517	,	448.2758621	,	724.137931	,	984.615385);
        
        
        Print (CBldU,  0.5, 1, 2, 4, 8, 12, 24, 48, 168 , 336 , 504 , 672 , 840 , 1008 , 1176 , 1344);
        Data  (CBldU, -1, -1, -1, -1, -1, -1, -1, -1, 0.00848	,	0.01066	,	0.01045	,	0.0107	,	0.01127	,	0.00811	,	0.00659	,	0.00525);
        
} # end of Experiment  
      

