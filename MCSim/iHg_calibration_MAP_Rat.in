} # end of Experiment 

      
Experiment { # Study 4, daily gavage with 230 ug Hg/kg )
        
        BW0 = 0.123;
        BWgrowth=1;
        sex=2;
        Growthrate = 0.00002412481;
        TChng 	= 0.05;
        
        
        # oral and IV administration
        PDose = PerDose(230, 24,  0, 0.05);
        IVDose = PerDose(0.0, 24,  0, 0.003);
        Drink = 0;
        
        expowk = PerDose(1.0, 168,  0, 120);
        expodur =  PerDose(1.0, 4320, 0, 4320);
        
        Print (CKU,  0.5, 1, 2, 4, 8, 12, 24, 48, 1428, 2868,	4308);
        Data  (CKU, -1, -1, -1, -1, -1, -1, -1, -1, 29.37, 55.59, 46.98);
        
} # end of Experiment 
      
